# Copier ce fichier en .env et renseigner les valeurs (ne jamais committer .env).
# scripts/install.ps1 et scripts/install.sh le font automatiquement.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Local sans Docker : SQLite par défaut. Docker Compose fournit PostgreSQL.
# DATABASE_URL=postgres://synthetiseur:synthetiseur@localhost:5432/synthetiseur
POSTGRES_PASSWORD=synthetiseur

# --- Règles métier ---
DAILY_DREAM_LIMIT=5
API_BUDGET_EUR=20

# --- Fournisseurs d'IA ---
# « fake » : doublures gratuites et déterministes (par défaut). « openai » : appels réels et payants.
AI_STT_PROVIDER=fake
AI_IMAGE_PROVIDER=fake
# « keywords » (repli intégré) ou « huggingface » (nécessite transformers + torch)
AI_EMOTION_PROVIDER=keywords
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
